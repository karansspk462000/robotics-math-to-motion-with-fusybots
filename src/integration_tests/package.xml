<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>integration_tests</name>
  <version>0.0.0</version>
  <description>End-to-end regression tests for bugs found during development (Cartesian straight-line motion, trajectory density/velocity consistency, KDL IK convergence, analytical IK accuracy), run through the real kinematics/motion_planner packages rather than re-derived expected values.</description>
  <maintainer email="karansspk@gmail.com">karan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>kinematics</depend>
  <depend>motion_planner</depend>
  <depend>path_planner</depend>
  <depend>path_interpolator</depend>
  <depend>trajectory_planner</depend>
  <depend>state_orchestrator</depend>
  <depend>collision_checking</depend>
  <depend>robot_description</depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
