<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kinematics</name>
  <version>0.0.0</version>
  <description>Forward/inverse kinematics behind IFKStrategy/IIKStrategy: generic DH, closed-form analytical (six-axis spherical wrist), and KDL-based (built directly from a URDF).</description>
  <maintainer email="karansspk@gmail.com">karan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>orocos_kdl</depend>
  <depend>kdl_parser</depend>
  <depend>ament_index_cpp</depend>
  <depend>math_utils</depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
