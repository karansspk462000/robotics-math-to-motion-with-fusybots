<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>state_orchestrator</name>
  <version>0.0.0</version>
  <description>Central robot orchestrator node: config-driven wiring of the ROS-free kinematics/path_planner/path_interpolator/trajectory_planner/motion_planner strategies to ROS topics. Future home for hw_interface and robot-state management.</description>
  <maintainer email="karansspk@gmail.com">karan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>custom_robot_msgs</depend>
  <depend>robot_config</depend>
  <depend>math_utils</depend>
  <depend>kinematics</depend>
  <depend>path_planner</depend>
  <depend>path_interpolator</depend>
  <depend>trajectory_planner</depend>
  <depend>motion_planner</depend>
  <depend>collision_checking</depend>

  <exec_depend>robot_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>hw_interface</exec_depend>
  <exec_depend>robot_ui</exec_depend>
  <exec_depend>mujoco_digital_twin</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
